---
import Footer from "../components/Footer.astro";
import Contact from "../components/Contact.astro";

const projects = [
  {
    title: "Tokajská záhrada",
    location: "Čerhov, Slovensko",
    year: "2013",
    image: "/images/projekty/01/zahrada_tokaj_1.jpg",
  },
  {
    title: "Záhrada s prístreškom",
    location:
      "Praha, Česká republika (projektované a realizované v zamestnaneckom pomere v Landart atelier s.r.o)",
    year: "2014",
    image: "/images/projekty/02/zahrada_s_pristreskom1.jpg",
  },
  {
    title: "Útočisko v lese",
    location: "Tatry, Slovensko",
    year: "2024",
    image:
      "https://images.unsplash.com/photo-1584738766473-61c083514bf4?auto=format&fit=crop&w=1600&q=85",
  },
  {
    title: "Mestská záhrada",
    location: "Brno, Česká republika",
    year: "2023",
    image:
      "https://images.unsplash.com/photo-1598902108854-10e335adac99?auto=format&fit=crop&w=1600&q=85",
  },
];
---

<!doctype html>
<html lang="sk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="HRTS VRDS — ateliér záhradnej a krajinnej architektúry. Individuálny prístup, zaujímavé riešenia, funkčnosť a precíznosť."
    />
    <title>HRTS VRDS — Záhradná architektúra</title>
  </head>

  <body>
    <header class="header">
      <a href="/" class="logo">HRTS VRDS<span>.</span></a>

      <nav>
        <a href="#projects">Projekty</a>
        <a href="#o-nas">O nás</a>
        <a href="#contact">Kontakt</a>
      </nav>

      <button class="menu" aria-label="Otvoriť menu">
        <span></span>
        <span></span>
      </button>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero">
        <div class="hero-image">
          <img
            src="/images/title.jpg"
            alt="Minimalistická záhrada"
          />
        </div>

        <div class="hero-content">
          <p class="eyebrow">
            Záhradná architektúra · Od roku 2015
          </p>

          <h1>
            HRTS VRDS<br />
            záhradní architekti.
          </h1>

          <div class="hero-bottom">
            <p class="eyebrow">
              Záhradná architektúra · Od roku 2015
            </p>

            <a
              href="#projects"
              class="circle-link"
              aria-label="Zobraziť projekty"
            >
              <span>↓</span>
            </a>
          </div>
        </div>
      </section>

      <!-- O NÁS -->
      <section class="intro" id="o-nas">
        <div class="section-number">01</div>

        <div class="intro-content">
          <p class="eyebrow">O nás</p>

          <h2>
            Tvoríme záhrady,<br />
            ktoré prinášajú<br />
            <em>radosť.</em>
          </h2>

          <div class="intro-text">
            <p>
              Sme dvojica záhradných architektov, ktorá sa po 5 ročnom
              pôsobení v praxi rozhodla založiť vlastný ateliér záhradnej a
              krajinnej architektúry – <strong>HRTS VRDS.</strong>
            </p>

            <p>
              Prinášame Vám individuálny prístup, zaujímavé riešenia,
              funkčnosť, precíznosť a veľa radosti z Vašej novej záhrady.
            </p>

            <a href="#contact" class="text-link">
              Kontaktujte nás
              <span>↗</span>
            </a>
          </div>
        </div>
      </section>

      <!-- SLUŽBY -->
      <section class="services">
        <div class="section-number">02</div>

        <div class="services-content">
          <p class="eyebrow">Naše služby</p>

          <div class="service-list">
            <div class="service">
              <span>01</span>

              <h3>Štúdia</h3>

              <p>
                Kompozičné riešenie záhrady.
              </p>
            </div>

            <div class="service">
              <span>02</span>

              <h3>Projektová dokumentácia</h3>

              <p>
                Kompletná projektová dokumentácia (PD).
              </p>
            </div>

            <div class="service">
              <span>03</span>

              <h3>Autorský dozor</h3>

              <p>
                Dohľad nad realizáciou a dodržaním navrhnutého riešenia.
              </p>
            </div>

            <div class="service">
              <span>04</span>

              <h3>Sadové úpravy</h3>

              <p>
                Realizácia sadových úprav podľa projektovej dokumentácie.
              </p>
            </div>

            <div class="service">
              <span>05</span>

              <h3>Závlahové systémy</h3>

              <p>
                Návrh a realizácia závlahových systémov.
              </p>
            </div>

            <div class="service">
              <span>06</span>

              <h3>Floristika a aranžovanie</h3>

              <p>
                Floristika, aranžovanie a tvorba kvetinových kompozícií.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- PROJECTS -->
      <section class="projects" id="projects">
        <div class="section-heading">
          <div>
            <p class="eyebrow">Vybrané realizácie</p>
            <h2>Projekty</h2>
          </div>

          <span class="section-number">03</span>
        </div>

        <div class="project-grid">
          {
            projects.map((project, index) => (
              <a
                href={`/projekty/${project.title.toLowerCase().replaceAll(" ", "-")}`}
                class={`project project-${index + 1}`}
              >
                <div class="project-image">
                  <img
                    src={project.image}
                    alt={project.title}
                    loading="lazy"
                  />

                  <span class="project-arrow">↗</span>
                </div>

                <div class="project-meta">
                  <div>
                    <h3>{project.title}</h3>
                    <p>{project.location}</p>
                  </div>

                  <span>{project.year}</span>
                </div>
              </a>
            ))
          }
        </div>

        <div class="projects-footer">
          <a href="/projekty" class="outline-button">
            Všetky projekty
            <span>↗</span>
          </a>
        </div>
      </section>

      <Contact />
    </main>
  </body>

  <Footer />
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f3f1ec;
    color: #1c1c1a;
    font-family:
      Arial,
      Helvetica,
      sans-serif;
    font-weight: 400;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }

  /* HEADER */

  .header {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28px 4vw;
    color: white;
  }

  .logo {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .logo span {
    opacity: 0.6;
  }

  nav {
    display: flex;
    gap: 38px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav a {
    position: relative;
  }

  nav a::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;
    width: 0;
    height: 1px;
    background: currentColor;
    transition: width 0.3s ease;
  }

  nav a:hover::after {
    width: 100%;
  }

  .menu {
    display: none;
    border: 0;
    background: none;
  }

  /* HERO */

  .hero {
    position: relative;
    height: 100svh;
    min-height: 680px;
    color: white;
    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
    background: #333;
  }

  .hero-image::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.32) 0%,
      rgba(0, 0, 0, 0.02) 45%,
      rgba(0, 0, 0, 0.45) 100%
    );
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: heroZoom 12s ease-out both;
  }

  @keyframes heroZoom {
    from {
      transform: scale(1.06);
    }

    to {
      transform: scale(1);
    }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 150px 4vw 45px;
  }

  .eyebrow {
    margin: 0;
    font-size: 10px;
    line-height: 1.4;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 0;
    max-width: 1100px;
    font-size: clamp(64px, 9.2vw, 150px);
    line-height: 0.87;
    letter-spacing: -0.065em;
    font-weight: 400;
  }

  h1 em,
  h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .hero-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }

  .hero-bottom p {
    width: 310px;
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
  }

  .circle-link {
    width: 58px;
    height: 58px;
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-size: 20px;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  .circle-link:hover {
    background: white;
    color: #1c1c1a;
  }

  /* O NÁS */

  .intro {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 5vw;
    padding: 160px 8vw 190px 4vw;
  }

  .section-number {
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .intro-content {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 8vw;
  }

  .intro-content h2 {
    grid-column: 1 / -1;
    margin: 70px 0 20px;
    font-size: clamp(46px, 6vw, 92px);
    line-height: 0.92;
    letter-spacing: -0.055em;
    font-weight: 400;
  }

  .intro-text {
    grid-column: 2;
    max-width: 390px;
  }

  .intro-text p {
    font-size: 14px;
    line-height: 1.7;
    margin-bottom: 28px;
  }

  .intro-text strong {
    font-weight: 600;
  }

  .text-link {
    display: inline-flex;
    gap: 22px;
    margin-top: 15px;
    padding-bottom: 8px;
    border-bottom: 1px solid #1c1c1a;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* SLUŽBY */

  .services {
    display: grid;
    grid-template-columns: 1fr 3fr;
    gap: 5vw;
    padding: 0 8vw 190px 4vw;
  }

  .services-content > .eyebrow {
    margin-bottom: 80px;
  }

  .service {
    display: grid;
    grid-template-columns: 50px 1.2fr 1fr;
    gap: 30px;
    padding: 30px 0;
    border-top: 1px solid #c9c6be;
  }

  .service:last-child {
    border-bottom: 1px solid #c9c6be;
  }

  .service > span {
    color: #8a8881;
    font-size: 10px;
  }

  .service h3 {
    margin: 0;
    font-size: 25px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .service p {
    max-width: 300px;
    margin: 0;
    color: #77756f;
    font-size: 15px;
    line-height: 1.6;
  }

  /* PROJECTS */

  .projects {
    padding: 0 4vw 170px;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 75px;
  }

  .section-heading h2 {
    margin: 24px 0 0;
    font-size: clamp(55px, 7vw, 110px);
    line-height: 0.85;
    letter-spacing: -0.06em;
    font-weight: 400;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 3vw;
    row-gap: 100px;
  }

  .project-2 {
    margin-top: 180px;
  }

  .project-4 {
    margin-top: 80px;
  }

  .project-image {
    position: relative;
    aspect-ratio: 1.15 / 1;
    overflow: hidden;
    background: #ddd;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .project:hover .project-image img {
    transform: scale(1.04);
  }

  .project-arrow {
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: white;
    opacity: 0;
    transform: translateY(10px);
    transition:
      opacity 0.3s ease,
      transform 0.3s ease;
  }

  .project:hover .project-arrow {
    opacity: 1;
    transform: translateY(0);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    padding-top: 18px;
  }

  .project-meta h3 {
    margin-bottom: 5px;
    font-size: 17px;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .project-meta p,
  .project-meta > span {
    margin: 0;
    color: #77756f;
    font-size: 11px;
    letter-spacing: 0.04em;
  }

  .projects-footer {
    margin-top: 100px;
    text-align: center;
  }

  .outline-button {
    display: inline-flex;
    gap: 45px;
    padding: 17px 22px;
    border: 1px solid #bbb8b0;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  .outline-button:hover {
    background: #1c1c1a;
    color: white;
  }

  /* MOBILE */

  @media (max-width: 800px) {
    .header {
      padding: 22px 5vw;
    }

    nav {
      display: none;
    }

    .menu {
      display: flex;
      flex-direction: column;
      gap: 5px;
      padding: 5px 0;
    }

    .menu span {
      display: block;
      width: 25px;
      height: 1px;
      background: white;
    }

    .hero-content {
      padding: 130px 5vw 30px;
    }

    h1 {
      font-size: clamp(54px, 15vw, 100px);
    }

    .hero-bottom p {
      width: 220px;
    }

    .intro,
    .services {
      grid-template-columns: 1fr;
      padding: 110px 5vw;
    }

    .intro-content {
      display: block;
    }

    .intro-content h2 {
      margin: 70px 0;
      font-size: 52px;
    }

    .intro-text {
      margin-left: 20%;
    }

    .services {
      padding-top: 0;
    }

    .services-content > .eyebrow {
      margin-bottom: 50px;
    }

    .service {
      grid-template-columns: 35px 1fr;
      gap: 15px;
    }

    .service h3 {
      font-size: 17px;
    }

    .service p {
      grid-column: 2;
      margin-top: 5px;
    }

    .projects {
      padding: 0 5vw 110px;
    }

    .section-heading {
      margin-bottom: 50px;
    }

    .project-grid {
      grid-template-columns: 1fr;
      row-gap: 65px;
    }

    .project-2,
    .project-4 {
      margin-top: 0;
    }

    .project-image {
      aspect-ratio: 1 / 1.05;
    }

    /* CONTACT - MOBILE */

    .contact {
      padding: 100px 5vw 30px;
    }

    .contact h2 {
      margin: 80px 0 70px;
      font-size: 18vw;
      line-height: 0.86;
    }

    .contact-details {
      grid-template-columns: 1fr 1fr;
      gap: 45px 25px;
      padding-top: 20px;
    }

    .contact-person a {
      font-size: 20px;
    }

    .billing-address {
      grid-column: 1 / -1;
    }

    .billing-address p:last-child {
      font-size: 12px;
    }

    .contact-email {
      margin-top: 65px;
      padding-bottom: 12px;
      font-size: 12vw;
      line-height: 0.9;
    }

    .email-arrow {
      font-size: 22px;
    }

    .contact-bottom {
      margin-top: 60px;
      gap: 20px;
      flex-wrap: wrap;
    }

    footer {
      padding: 25px 5vw;
    }

    footer p {
      display: none;
    }
  }
</style>