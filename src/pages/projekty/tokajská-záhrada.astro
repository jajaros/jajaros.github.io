<style>

  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background: #f3f1ec;
    color: #1c1c1a;
    font-family: Arial, Helvetica, sans-serif;
  }

  :global(a) {
    color: inherit;
    text-decoration: none;
  }


  /* HEADER */

  .header {
    position: absolute;
    z-index: 10;
    top: 0;
    left: 0;
    width: 100%;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 28px 4vw;

    color: white;
  }

  .logo {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .logo span {
    opacity: 0.6;
  }

  nav {
    display: flex;
    gap: 38px;

    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  nav a,
  .back {
    position: relative;
  }

  nav a::after,
  .back::after {
    content: "";
    position: absolute;
    bottom: -6px;
    left: 0;

    width: 0;
    height: 1px;

    background: currentColor;

    transition: width 0.3s ease;
  }

  nav a:hover::after,
  .back:hover::after {
    width: 100%;
  }

  .back {
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }


  /* HERO */

  .project-hero {
    position: relative;

    height: 100svh;
    min-height: 700px;

    color: white;

    overflow: hidden;
  }

  .hero-image {
    position: absolute;
    inset: 0;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    animation: heroZoom 12s ease-out both;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.4) 0%,
        rgba(0, 0, 0, 0.05) 45%,
        rgba(0, 0, 0, 0.5) 100%
      );
  }

  @keyframes heroZoom {

    from {
      transform: scale(1.06);
    }

    to {
      transform: scale(1);
    }

  }

  .hero-content {
    position: relative;
    z-index: 2;

    height: 100%;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: 130px 4vw 40px;
  }

  .hero-top,
  .hero-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .eyebrow {
    margin: 0;

    font-size: 10px;
    line-height: 1.4;

    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hero-content h1 {
    margin: auto 0 80px;

    font-size: clamp(70px, 10vw, 160px);
    line-height: 0.84;

    letter-spacing: -0.07em;
    font-weight: 400;
  }

  .hero-content h1 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .hero-bottom {
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .scroll {
    width: 55px;
    height: 55px;

    display: grid;
    place-items: center;

    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;

    font-size: 20px;

    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  .scroll:hover {
    background: white;
    color: #1c1c1a;
  }


  /* INTRO */

  .intro {
    display: grid;

    grid-template-columns: 1fr 3fr;
    gap: 5vw;

    padding: 160px 8vw 180px 4vw;
  }

  .section-number {
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .intro-content {
    display: grid;

    grid-template-columns: 1.3fr 0.7fr;
    gap: 7vw;
  }

  .intro-content > .eyebrow {
    grid-column: 1 / -1;
  }

  .intro-content h2 {
    grid-column: 1 / -1;

    margin: 50px 0 20px;

    max-width: 1000px;

    font-size: clamp(52px, 7vw, 105px);
    line-height: 0.9;

    letter-spacing: -0.06em;
    font-weight: 400;
  }

  .intro-content h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .intro-text {
    grid-column: 2;
    max-width: 420px;
  }

  .intro-text p {
    margin-bottom: 25px;

    font-size: 14px;
    line-height: 1.75;
  }


  /* FULL IMAGE */

  .full-image {
    width: 100%;
    height: 80vh;
    overflow: hidden;
  }

  .full-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform 1s ease;
  }

  .full-image:hover img {
    transform: scale(1.025);
  }


  /* CONCEPT */

  .concept {
    display: grid;

    grid-template-columns: 1fr 3fr;
    gap: 5vw;

    padding: 170px 8vw 190px 4vw;
  }

  .concept-content > .eyebrow {
    margin-bottom: 70px;
  }

  .concept-content h2 {
    max-width: 1000px;

    margin: 0 0 100px;

    font-size: clamp(48px, 6vw, 90px);
    line-height: 0.92;

    letter-spacing: -0.055em;
    font-weight: 400;
  }

  .concept-content h2 em {
    font-family: Georgia, "Times New Roman", serif;
    color: #77756f;
    font-weight: 400;
  }

  .concept-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;
    gap: 7vw;

    max-width: 850px;
  }

  .concept-grid p {
    margin: 0;

    color: #686660;

    font-size: 14px;
    line-height: 1.75;
  }


  /* GALLERY */

  .gallery {
    padding: 0 4vw 180px;
  }

  .gallery-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;

    margin-bottom: 70px;
  }

  .gallery-grid {
    display: grid;

    grid-template-columns: 1fr 1fr;
    gap: 3vw;
  }

  .gallery-image {
    overflow: hidden;
    background: #ddd;
  }

  .gallery-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    transition: transform 0.8s ease;
  }

  .gallery-image:hover img {
    transform: scale(1.035);
  }

  .gallery-large {
    aspect-ratio: 1.15 / 1;
  }

  .gallery-small {
    aspect-ratio: 0.9 / 1;
  }


  /* DETAILS */

  .details {
    display: grid;

    grid-template-columns: 1fr 3fr;
    gap: 5vw;

    padding: 150px 8vw 170px 4vw;

    background: #20211e;
    color: #e8e5de;
  }

  .details-content > .eyebrow {
    margin-bottom: 70px;
  }

  .details-list {
    max-width: 900px;
  }

  .detail {
    display: grid;

    grid-template-columns: 1fr 1.5fr;

    padding: 25px 0;

    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .detail:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .detail span {
    color: #96948d;

    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .detail strong {
    font-size: 14px;
    font-weight: 400;
  }


  /* FINAL IMAGE */

  .final-image {
    position: relative;

    height: 90vh;
    overflow: hidden;
  }

  .final-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .final-caption {
    position: absolute;

    right: 4vw;
    bottom: 35px;
    left: 4vw;

    display: flex;
    justify-content: space-between;

    color: white;

    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }


  /* NEXT PROJECT */

  .next-project {
    position: relative;

    padding: 150px 4vw 180px;
  }

  .next-project > .eyebrow {
    margin-bottom: 100px;
  }

  .next-project a {
    position: relative;
    display: block;
  }

  .next-project h2 {
    margin: 0;

    font-size: clamp(60px, 9vw, 140px);
    line-height: 0.85;

    letter-spacing: -0.065em;
    font-weight: 400;
  }

  .next-project h2 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
  }

  .next-arrow {
    position: absolute;

    right: 0;
    bottom: 0;

    width: 65px;
    height: 65px;

    display: grid;
    place-items: center;

    border: 1px solid #aaa69e;
    border-radius: 50%;

    font-size: 20px;

    transition:
      background 0.3s ease,
      color 0.3s ease;
  }

  .next-project a:hover .next-arrow {
    background: #1c1c1a;
    color: white;
  }


  /* FOOTER */

  footer {
    display: flex;

    align-items: center;
    justify-content: space-between;

    padding: 30px 4vw;

    background: #d8d4ca;

    border-top: 1px solid #b8b4aa;
  }

  footer p,
  footer > a:last-child {
    margin: 0;

    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }


  /* MOBILE */

  @media (max-width: 800px) {

    .header {
      padding: 22px 5vw;
    }

    nav {
      display: none;
    }

    .back {
      font-size: 9px;
    }

    .hero-content {
      padding: 120px 5vw 30px;
    }

    .hero-content h1 {
      margin-bottom: 60px;
      font-size: 17vw;
    }

    .hero-top {
      align-items: flex-start;
      gap: 20px;
    }

    .hero-top .eyebrow:last-child {
      text-align: right;
    }

    .intro,
    .concept,
    .details {
      grid-template-columns: 1fr;
      padding: 110px 5vw;
    }

    .intro-content,
    .concept-grid {
      display: block;
    }

    .intro-content h2 {
      margin: 60px 0;
      font-size: 54px;
    }

    .intro-text {
      margin-left: 15%;
    }

    .full-image {
      height: 60vh;
    }

    .concept-content > .eyebrow {
      margin-bottom: 55px;
    }

    .concept-content h2 {
      margin-bottom: 70px;
      font-size: 50px;
    }

    .concept-grid p + p {
      margin-top: 30px;
    }

    .gallery {
      padding: 0 5vw 110px;
    }

    .gallery-heading {
      margin-bottom: 45px;
    }

    .gallery-grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    .gallery-large,
    .gallery-small {
      aspect-ratio: 1 / 1.05;
    }

    .details-content > .eyebrow {
      margin-bottom: 50px;
    }

    .detail {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .final-image {
      height: 65vh;
    }

    .final-caption {
      right: 5vw;
      bottom: 25px;
      left: 5vw;
      gap: 20px;
    }

    .next-project {
      padding: 110px 5vw;
    }

    .next-project > .eyebrow {
      margin-bottom: 70px;
    }

    .next-project h2 {
      font-size: 16vw;
    }

    .next-arrow {
      position: relative;
      right: auto;
      bottom: auto;
      margin-top: 50px;
    }

    footer {
      padding: 25px 5vw;
    }

    footer p {
      display: none;
    }

  }

</style>
