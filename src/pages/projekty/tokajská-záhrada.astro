        </div>

        <div class="detail">
          <span>Typ</span>
          <strong>Súkromná záhrada</strong>
        </div>

        <div class="detail">
          <span>Rozsah</span>
          <strong>Návrh · Projekt · Realizácia</strong>
        </div>

        <div class="detail">
          <span>Ateliér</span>
          <strong>HRTS VRDS</strong>
        </div>

      </div>

    </div>

  </section>


  <!-- FINAL IMAGE -->

  <section class="final-image">

    <img
